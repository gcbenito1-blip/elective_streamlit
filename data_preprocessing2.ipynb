        "import pandas as pd\n",
        "import asyncio\n",
        "from googletrans import Translator\n",
        "import unicodedata\n",
        "from tqdm.notebook import trange, tqdm\n",
        "from time import sleep\n",
        "import re"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "tgl=pd.read_csv('/content/sample_data/tgl_review.csv', index_col=0 )\n",
        "\n",
        "items = tgl['content'].tolist()\n",
        "translated = []"
      ],
      "metadata": {
        "id": "jhRTAR6ojAhT"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "translator, runs slow\n",
        "async def translate_bulk():\n",
        "  async with Translator() as translator:\n",
        "      translations = await translator.translate(items, dest='en')\n",
        "      return [t.text for t in translations]\n",
        "\n",
        "translated = await translate_bulk()\n",
        "\n",
        "tgl['translated'] = translated"
      ],
      "metadata": {
        "id": "zLHze1uplv9B"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "async def translate_bulk(items, batch_size=20):\n",
        "    results = []\n",
        "\n",
        "    async with Translator() as translator:\n",
        "        with tqdm(total=len(items)) as pbar:\n",
        "            for i in range(0, len(items), batch_size):\n",
        "                batch = items[i:i+batch_size]\n",
        "                translations = await translator.translate(batch, dest='en')\n",
        "\n",
        "                batch_result = [t.text for t in translations]\n",
        "                results.extend(batch_result)\n",
        "\n",
        "                pbar.update(len(batch))\n",
        "\n",
        "    return results\n",
        "\n",
        "translated = await translate_bulk(items)\n",
        "tgl['translated'] = translated"
      ],
